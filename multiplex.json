{
    "presets": {
        "basic" : [
            { "arg": "test-type", "vals": ["stream"] },
            { "arg": "wsize", "vals": ["16384"] },
            { "arg": "duration", "vals": ["60"] },
            { "arg": "protocol", "vals": ["tcp"] },
            { "arg": "nthreads", "vals": ["1"] }
        ]
    },
    "validations": {
        "yesno": {
          "description": "yes|no",
          "args": [
            "history",
            "histogram",
            "quiet"
          ],
          "vals": "yes|no"
        },
        "test-types": {
            "description": "all possible test-types",
            "args": [ "test-type" ],
            "vals": "^stream$|^crr$|^rr$|^ping-pong$"
        },
        "protocols": {
            "description": "all possible protocols",
            "args": [ "protocol" ],
            "vals": "^tcp$|^tcp_zc$|^udp$"
        },
        "ipv": {
            "description": "ipv4 or ipv6",
            "args": [ "ipv" ],
            "vals": "^4$|^6$"
        },
        "divisible-by-1000": {
            "description": "a number divisible by 1000",
            "args": [ "bucket-length", "max-bucket" ],
            "vals": "^(0|[1-9][0-9]*000)$"
        },
        "positive_integer": {
            "description": "a whole number greater than 0",
            "args": [ "wsize", "rsize", "nthreads", "duration" ],
            "vals": "[1-9][0-9]*"
        },
        "positive_float": {
            "description": "a floating point number greater than 0",
            "args": [ "think" ],
            "vals": "[0-9]*\\.[0-9]*"
        },
        "host-or-ip": {
            "description" : "a hostname or IP address",
            "args": [ "remotehost" ],
            "vals": ".+"
        },
        "non-empty-string": {
            "description": "any non-empty string",
            "args": [ "ifname" ],
            "vals": "^.+$"
        },
        "passthru": {
            "description": "comma separated list",
            "args": [ "passthru" ],
            "vals": "^.+$"
        },
        "cpu-pinning": {
            "description": "valid cpu pinning modes",
            "args": [ "cpu-pin", "irq-pin" ],
            "vals": "^numa$|^cpu:(([0-9]*)(-[1-9][0-9]*)?)(,(([1-9][0-9]*)(-[1-9][0-9]*)?))*$"
        },
        "priority": {
            "description": "fifo priority for irq handlers",
            "args": [ "irq-prio", "softirq-prio" ],
            "vals": "^0$|^[1-9][0-9]?$"
        },
        "cpu-affinity": {
            "description": "cpu pin for uperf",
            "args": [ "main-thread" ],
            "vals": "^[1-9][0-9]?$"
        },
        "cpu-range": {
            "description": "cpu range for uperf",
            "args": [ "worker-thread" ],
            "vals": "^[1-9][0-9]?(-[1-9][0-9]?)?(,[1-9][0-9]?(-[1-9][0-9]?)?)*$"
        }
    }
}
