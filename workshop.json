{
    "workshop": {
        "schema": {
            "version": "2020.03.02"
        }
    },
    "userenvs": [
	    {
	        "name": "default",
	        "requirements": [
                "uperf_sferlin"
	        ]
	    }
    ],
    "requirements": [
	    {
	        "name": "uperf_src",
	        "type": "source",
	        "source_info": {
		        "url": "https://github.com/uperf/uperf/archive/1.0.7.tar.gz",
		        "filename": "1.0.7.tar.gz",
		        "commands": { 
		            "unpack": "tar -xzf 1.0.7.tar.gz",
		            "get_dir": "tar -tzf 1.0.7.tar.gz | head -n 1",
		            "commands": [
			            "CFLAGS=\"-ggdb\" ./configure --disable-sctp",
			            "make",
			            "make install",
			            "ldconfig",
			            "/usr/local/bin/uperf -V"
		            ]
                }
	        }
        },
		{
			"name": "uperf_sferlin",
			"type": "manual",
			"manual_info": {
				"commands": [
					"rm -rf /tmp/uperf_sferlin",
					"git clone https://github.com/sferlin/uperf.git /tmp/uperf_sferlin",
					"cd /tmp/uperf_sferlin && git checkout 524fcbdbd19e41efcf31ecdf4f0739fbd7fd235d",
					"cd /tmp/uperf_sferlin && autoreconf --install && ./configure --disable-sctp && make install",
					"ldconfig",
					"/usr/local/bin/uperf -V"
				]
	        }
        }
    ]
}
